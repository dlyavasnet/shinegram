diff --git a/submodules/TelegramCore/Sources/Shine/ShineMessageAttributes.swift b/submodules/TelegramCore/Sources/Shine/ShineMessageAttributes.swift
new file mode 100644
index 00000000..914a39b0
--- /dev/null
+++ b/submodules/TelegramCore/Sources/Shine/ShineMessageAttributes.swift
@@ -0,0 +1,167 @@
+import Foundation
+import Postbox
+
+public final class ShineDeletedMessageAttribute: MessageAttribute, Equatable {
+    public let deletedAt: Int32
+
+    public init(deletedAt: Int32) {
+        self.deletedAt = deletedAt
+    }
+
+    required public init(decoder: PostboxDecoder) {
+        self.deletedAt = decoder.decodeInt32ForKey("d", orElse: 0)
+    }
+
+    public func encode(_ encoder: PostboxEncoder) {
+        encoder.encodeInt32(self.deletedAt, forKey: "d")
+    }
+
+    public static func ==(lhs: ShineDeletedMessageAttribute, rhs: ShineDeletedMessageAttribute) -> Bool {
+        return lhs.deletedAt == rhs.deletedAt
+    }
+}
+
+public struct ShineEditHistoryEntry: Equatable {
+    public let text: String
+    public let date: Int32
+
+    public init(text: String, date: Int32) {
+        self.text = text
+        self.date = date
+    }
+}
+
+public final class ShineEditHistoryMessageAttribute: MessageAttribute, Equatable {
+    public static let maxEntries = 50
+
+    public let entries: [ShineEditHistoryEntry]
+
+    public init(entries: [ShineEditHistoryEntry]) {
+        self.entries = entries
+    }
+
+    required public init(decoder: PostboxDecoder) {
+        let texts = decoder.decodeStringArrayForKey("t")
+        let dates = decoder.decodeInt32ArrayForKey("d")
+        var entries: [ShineEditHistoryEntry] = []
+        for (index, text) in texts.enumerated() {
+            entries.append(ShineEditHistoryEntry(text: text, date: index < dates.count ? dates[index] : 0))
+        }
+        self.entries = entries
+    }
+
+    public func encode(_ encoder: PostboxEncoder) {
+        encoder.encodeStringArray(self.entries.map { $0.text }, forKey: "t")
+        encoder.encodeInt32Array(self.entries.map { $0.date }, forKey: "d")
+    }
+
+    public func appending(_ entry: ShineEditHistoryEntry) -> ShineEditHistoryMessageAttribute {
+        var entries = self.entries
+        entries.append(entry)
+        if entries.count > ShineEditHistoryMessageAttribute.maxEntries {
+            entries.removeFirst(entries.count - ShineEditHistoryMessageAttribute.maxEntries)
+        }
+        return ShineEditHistoryMessageAttribute(entries: entries)
+    }
+
+    public static func ==(lhs: ShineEditHistoryMessageAttribute, rhs: ShineEditHistoryMessageAttribute) -> Bool {
+        return lhs.entries == rhs.entries
+    }
+}
+
+public extension Message {
+    var shineDeletedAttribute: ShineDeletedMessageAttribute? {
+        for attribute in self.attributes {
+            if let attribute = attribute as? ShineDeletedMessageAttribute {
+                return attribute
+            }
+        }
+        return nil
+    }
+
+    var shineEditHistory: ShineEditHistoryMessageAttribute? {
+        for attribute in self.attributes {
+            if let attribute = attribute as? ShineEditHistoryMessageAttribute {
+                return attribute
+            }
+        }
+        return nil
+    }
+}
+
+func shineStoreMessage(_ message: Message, attributes: [MessageAttribute]) -> StoreMessage {
+    var storeForwardInfo: StoreMessageForwardInfo?
+    if let forwardInfo = message.forwardInfo {
+        storeForwardInfo = StoreMessageForwardInfo(authorId: forwardInfo.author?.id, sourceId: forwardInfo.source?.id, sourceMessageId: forwardInfo.sourceMessageId, date: forwardInfo.date, authorSignature: forwardInfo.authorSignature, psaType: forwardInfo.psaType, flags: forwardInfo.flags)
+    }
+    return StoreMessage(id: message.id, customStableId: nil, globallyUniqueId: message.globallyUniqueId, groupingKey: message.groupingKey, threadId: message.threadId, timestamp: message.timestamp, flags: StoreMessageFlags(message.flags), tags: message.tags, globalTags: message.globalTags, localTags: message.localTags, forwardInfo: storeForwardInfo, authorId: message.author?.id, text: message.text, attributes: attributes, media: message.media)
+}
+
+func shineMarkMessagesDeleted(transaction: Transaction, ids: [MessageId]) -> [MessageId] {
+    let timestamp = Int32(Date().timeIntervalSince1970)
+    var remaining: [MessageId] = []
+    for id in ids {
+        guard id.namespace == Namespaces.Message.Cloud, let message = transaction.getMessage(id), !message.flags.contains(.Unsent) else {
+            remaining.append(id)
+            continue
+        }
+        if message.shineDeletedAttribute != nil {
+            continue
+        }
+        transaction.updateMessage(id, update: { current in
+            var attributes = current.attributes
+            attributes.append(ShineDeletedMessageAttribute(deletedAt: timestamp))
+            return .update(shineStoreMessage(current, attributes: attributes))
+        })
+    }
+    return remaining
+}
+
+func shineAppendEditHistory(previous: Message, updated: StoreMessage) -> StoreMessage {
+    guard previous.text != updated.text, !previous.text.isEmpty else {
+        if let history = previous.shineEditHistory, !updated.attributes.contains(where: { $0 is ShineEditHistoryMessageAttribute }) {
+            return updated.withUpdatedAttributes(updated.attributes + [history])
+        }
+        return updated
+    }
+    var editDate = previous.timestamp
+    for attribute in previous.attributes {
+        if let attribute = attribute as? EditedMessageAttribute {
+            editDate = attribute.date
+        }
+    }
+    let entry = ShineEditHistoryEntry(text: previous.text, date: editDate)
+    let history = (previous.shineEditHistory ?? ShineEditHistoryMessageAttribute(entries: [])).appending(entry)
+    var attributes = updated.attributes.filter { !($0 is ShineEditHistoryMessageAttribute) }
+    attributes.append(history)
+    return updated.withUpdatedAttributes(attributes)
+}
+
+func shineGhostScheduledMessages(transaction: Transaction, accountPeerId: PeerId, peerId: PeerId, messages: [(Bool, EnqueueMessage)]) -> [(Bool, EnqueueMessage)] {
+    guard ShineSettings.sendAsScheduled else {
+        return messages
+    }
+    if peerId == accountPeerId || peerId.namespace == Namespaces.Peer.SecretChat {
+        return messages
+    }
+    if let user = transaction.getPeer(peerId) as? TelegramUser, user.botInfo != nil {
+        return messages
+    }
+    let scheduleTime = Int32(Date().timeIntervalSince1970) + ShineSettings.ghostScheduleDelay
+    return messages.map { transformed, message in
+        if message.attributes.contains(where: { $0 is OutgoingScheduleInfoMessageAttribute }) {
+            return (transformed, message)
+        }
+        return (transformed, message.withUpdatedAttributes { attributes in
+            return attributes + [OutgoingScheduleInfoMessageAttribute(scheduleTime: scheduleTime, repeatPeriod: nil)]
+        })
+    }
+}
+
+func shineAdjustedScheduleTime(_ scheduleTime: Int32) -> Int32 {
+    if scheduleTime == scheduleWhenOnlineTimestamp {
+        return scheduleTime
+    }
+    let minimum = Int32(Date().timeIntervalSince1970) + 5
+    return max(scheduleTime, minimum)
+}
