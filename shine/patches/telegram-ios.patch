+import Foundation
+
+public final class ShineSettings {
+    public enum Key: String, CaseIterable {
+        case ghostHideReadReceipts = "shine.ghost.hideReadReceipts"
+        case ghostHideOnline = "shine.ghost.hideOnline"
+        case ghostHideTyping = "shine.ghost.hideTyping"
+        case ghostHideStoryViews = "shine.ghost.hideStoryViews"
+        case ghostHideMediaListened = "shine.ghost.hideMediaListened"
+        case ghostSendAsScheduled = "shine.ghost.sendAsScheduled"
+        case saveDeletedMessages = "shine.saveDeletedMessages"
+        case saveEditHistory = "shine.saveEditHistory"
+        case hideSponsoredMessages = "shine.hideSponsoredMessages"
+        case streamerMode = "shine.streamerMode"
+        case hideStories = "shine.hideStories"
+        case showMessageSeconds = "shine.showMessageSeconds"
+        case showIds = "shine.showIds"
+    }
+
+    public static let appIconKey = "shine.appIcon"
+
+    public static var appIcon: String? {
+        get {
+            return defaults.string(forKey: appIconKey)
+        }
+        set {
+            defaults.set(newValue, forKey: appIconKey)
+            NotificationCenter.default.post(name: didChangeNotification, object: nil)
+        }
+    }
+
+    public static let didChangeNotification = Notification.Name("ShineSettingsDidChange")
+
+    private static var defaults: UserDefaults {
+        return UserDefaults.standard
+    }
+
+    public static let ghostScheduleDelay: Int32 = 12
+
+    public static func defaultValue(_ key: Key) -> Bool {
+        switch key {
+        case .saveDeletedMessages, .saveEditHistory, .hideSponsoredMessages, .showIds:
+            return true
+        default:
+            return false
+        }
+    }
+
+    public static func value(_ key: Key) -> Bool {
+        if let value = defaults.object(forKey: key.rawValue) as? Bool {
+            return value
+        }
+        return defaultValue(key)
+    }
+
+    public static func set(_ key: Key, _ value: Bool) {
+        defaults.set(value, forKey: key.rawValue)
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+
+    public static var ghostKeys: [Key] {
+        return [.ghostHideReadReceipts, .ghostHideOnline, .ghostHideTyping, .ghostHideStoryViews, .ghostHideMediaListened, .ghostSendAsScheduled]
+    }
+
+    public static var isGhostModeEnabled: Bool {
+        return ghostKeys.allSatisfy { value($0) }
+    }
+
+    public static func setGhostMode(_ enabled: Bool) {
+        for key in ghostKeys {
+            defaults.set(enabled, forKey: key.rawValue)
+        }
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+
+    public static var hideReadReceipts: Bool { value(.ghostHideReadReceipts) }
+    public static var hideOnline: Bool { value(.ghostHideOnline) }
+    public static var hideTyping: Bool { value(.ghostHideTyping) }
+    public static var hideStoryViews: Bool { value(.ghostHideStoryViews) }
+    public static var hideMediaListened: Bool { value(.ghostHideMediaListened) }
+    public static var sendAsScheduled: Bool { value(.ghostSendAsScheduled) }
+    public static var saveDeletedMessages: Bool { value(.saveDeletedMessages) }
+    public static var saveEditHistory: Bool { value(.saveEditHistory) }
+    public static var hideSponsoredMessages: Bool { value(.hideSponsoredMessages) }
+    public static var streamerMode: Bool { value(.streamerMode) }
+    public static var hideStories: Bool { value(.hideStories) }
+    public static var showMessageSeconds: Bool { value(.showMessageSeconds) }
+    public static var showIds: Bool { value(.showIds) }
+}
